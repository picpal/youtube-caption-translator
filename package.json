{
  "name": "youtube-play-assistant",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Personal YouTube learning Chrome extension (Korean subtitles + transcript)",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite --config preview/vite.config.ts",
    "dev:chrome": "node scripts/dev-chrome.mjs",
    "dev:chrome:stop": "node scripts/dev-chrome-stop.mjs",
    "dev:chrome:check": "node scripts/dev-chrome-check.mjs",
    "dev:chrome:check:panel": "node scripts/dev-chrome-check-panel.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wxt": "^0.19.29"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@wxt-dev/module-react": "^1.2.2",
    "autoprefixer": "^10.5.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.22",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^1.6.1"
  }
}
